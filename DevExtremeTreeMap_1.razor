@* ============================================================================
   DevExtreme dxTreeMap sarmalayıcısı (SEÇENEK 1 — JS interop) — AKTİF
   Gereksinim: sayfada dx.all.js + wwwroot/js/treemap-interop.js

   Parametreleri ApexTreeMap ile birebir aynıdır (Data, Selected, OnCellClick),
   böylece DenetimDashboard.razor içinde tek satır değiştirerek geçiş yapılır.

   v2 DEĞİŞİKLİKLERİ
   • OnAfterRenderAsync her render'da update() çağırıyordu. Blazor Server'da bu,
     üst bileşenin her render'ında (ör. arama kutusundaki her tuş vuruşunda)
     SignalR üzerinden bir interop çağrısı + tüm veri dizisinin yeniden
     serileştirilmesi demekti. Artık imza karşılaştırması var.
   • İki farklı [JSInvokable] aynı işi yapıyordu (biri ölü kod); tek metoda indi.
   • DevExtreme yüklü değilse sessizce boş kutu kalmıyor; geliştiriciye görünür
     bir uyarı basıyor (create() artık bool döndürüyor).
   ============================================================================ *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="host" class="dxtm-host" style="width:100%;height:100%;min-height:150px"></div>

@if (loadFailed)
{
    <p class="dxtm-error">
        DevExtreme (<code>dx.all.js</code>) sayfada yüklü değil, treemap çizilemedi.
        <code>App.razor</code> içine
        <code>&lt;script src="_content/DevExpress.Blazor/dx.all.js"&gt;&lt;/script&gt;</code>
        ekleyin.
    </p>
}

@code {
    [Parameter, EditorRequired] public List<CategoryValue> Data { get; set; } = new();

    /// <summary>Seçili hücrenin etiketi (çapraz filtre). null = seçim yok.</summary>
    [Parameter] public string? Selected { get; set; }

    [Parameter] public EventCallback<string> OnCellClick { get; set; }

    ElementReference host;
    IJSObjectReference? module;
    DotNetObjectReference<DevExtremeTreeMap>? selfRef;
    bool created;
    bool loadFailed;
    string? renderedSignature;

    /// <summary>JS tarafının beklediği şekil: { name, value, color }</summary>
    record Point(string name, double value, string color);

    object[] BuildPayload()
        => Data.Select(d => (object)new Point(d.Label, d.Value, d.Color)).ToArray();

    string BuildSignature()
    {
        var sb = new System.Text.StringBuilder();
        foreach (var d in Data)
        {
            sb.Append(d.Label).Append(':').Append(d.Value).Append('|');
        }
        sb.Append('#').Append(Selected);
        return sb.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/treemap-interop.js");
                selfRef = DotNetObjectReference.Create(this);
                renderedSignature = BuildSignature();

                created = await module.InvokeAsync<bool>("create", host, BuildPayload(), selfRef, Selected);

                if (!created)
                {
                    loadFailed = true;
                    StateHasChanged();
                }
            }
            catch (JSDisconnectedException) { }
            return;
        }

        if (!created || module is null) return;

        var signature = BuildSignature();
        if (signature == renderedSignature) return;   // gerçek bir değişiklik yok → interop yok

        renderedSignature = signature;

        try
        {
            await module.InvokeVoidAsync("update", host, BuildPayload(), Selected);
        }
        catch (JSDisconnectedException) { }
    }

    // JS modülü bu adla çağırır: dotNetRef.invokeMethodAsync('OnCellClick', label)
    [JSInvokable("OnCellClick")]
    public Task OnCellClickInterop(string label) => OnCellClick.InvokeAsync(label);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                if (created) await module.InvokeVoidAsync("dispose", host);
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { /* devre kapandı, temizlik gereksiz */ }
        catch (TaskCanceledException) { }
        finally
        {
            selfRef?.Dispose();
        }
    }
}
