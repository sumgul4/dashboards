@page "/denetim-dashboard"
@using Denetim.Dashboard
@using DevExpress.Blazor
@implements IDisposable
@inject DenetimRepository Repo

@* ==================================================================================
   Denetim Raporlama Panosu — Power BI raporunun Blazor Server karşılığı
   DevExpress Blazor v25.2 · .NET 10

   ---- v2'DE DÜZELTİLEN DERLEME HATALARI -------------------------------------------
   1) CS0841 "Cannot use local variable 'RenderAnasayfa' before it is declared"
      Sebep: RenderAnasayfa/RenderGenelBakis/... birer YEREL DEĞİŞKEN'di
      (RenderFragment X = @@<text>...) ve markup'tan SONRA gelen @@{ } bloğunda
      tanımlanmıştı. Razor tüm dosyayı tek bir BuildRenderTree metodu olarak
      derler; C#'ta bir yerel değişken bildiriminden önce kullanılamaz.
      RenderProjeksiyon(...) hata vermiyordu, çünkü o bir YEREL FONKSİYON'du —
      yerel fonksiyonlar bildirimden önce çağrılabilir.
      Çözüm: hepsi yerel fonksiyona çevrildi VE blok markup'tan önceye alındı.
      (Kullanım da @@RenderAnasayfa yerine @@RenderAnasayfa() oldu.)

   2) CS1503 "Argument 1: cannot convert from 'method group' to ChartElementFormat"
      Sebep: ChartElementFormat.Percent bir SABİT değil, statik bir FABRİKA
      METODU. Parantezsiz yazıldığında ifade bir "method group" olur.
      Çözüm: ValueFormat="@@(ChartElementFormat.Percent(1))"
      (Ayrıca DxChartSeriesLabel'da "Format" adlı parametre YOK — doğrusu
       ValueFormat. IntelliSense listesinde ArgumentFormat / ValueFormat /
       FormatPattern var, Format yok.)
      (Projenizde Percent(int) aşırı yüklemesi yoksa Percent() olarak yazın.)

   3) CS0103 "The name 'DashStyle' does not exist in the current context"
      Sebep: DxChartLineSeries üzerindeki DashStyle PARAMETRESİ var (VS onu
      kırmızı işaretlemedi), sorunlu olan DEĞER ifadesi: 'DashStyle' adlı tip
      @@using DevExpress.Blazor kapsamında bulunamıyor.
      Çözüm: parametre şimdilik kaldırıldı; Plan/Gerçekleşen ayrımı renkle
      yapılıyor. Kesir çizgisini geri eklemek isterseniz doğru tip adını
      3 saniyede bulmanın yolu: DashStyle="" içine imleci koyup Ctrl+Space,
      veya DashStyle parametresinin üzerinde F12. En olası iki aday:
        DashStyle="System.Drawing.Drawing2D.DashStyle.Dash"
        DashStyle="ChartDashStyle.Dash"
      Doğru adı bulunca 'PROJEKSİYON' bölümündeki yorumlu satırı açın.

   ---- v2'DE YAPILAN PERFORMANS DÜZELTMELERİ ---------------------------------------
   • Filtrelenmiş veri artık her render'da yeniden hesaplanmıyor. Eskiden
     FilteredSubeler / FilteredPlanRows / Kpis / AksiyonDurumu birer computed
     property'ydi; her render'da YENİ bir nesne referansı üretiyorlardı ve
     DxGrid/DxChart bunu "veri kaynağı değişti" olarak görüp tamamen yeniden
     yükleniyordu. Şimdi tek giriş noktası LoadAsync(); yalnız filtre/sayfa
     değişince çalışır. (Veritabanına geçince bu, "her render'da sorgu"
     ile "filtre başına bir sorgu" arasındaki fark demek.)
   • @@FilteredSubeler.Count() LINQ sorgusunu ikinci kez dolaşıyordu (grid ile
     birlikte toplam 2 kez). Artık materialize edilmiş listenin .Count'u.
   • Arama kutusu BindValueMode.OnInput ile her tuş vuruşunda tüm sayfayı
     (tüm grafikler + grid + treemap JS interop) yeniden render ediyordu.
     Artık OnDelayedInput + InputDelay.
   • Enum.GetValues / new[] { "2025", "2026" } gibi diziler her render'da
     yeniden ayrılıyordu; static readonly alanlara taşındı.
   • @@foreach döngülerine @@key eklendi (Blazor diff maliyeti).
   • Treemap tıklamasındaki gereksiz StateHasChanged() kaldırıldı —
     EventCallback tetiklendiğinde Blazor zaten render ediyor (çift render).
   • ProjeksiyonKpis() artık Last(...) yerine LastOrDefault + sıfıra bölme
     koruması kullanıyor (gerçek veriyle "hiç gerçekleşme yok" hâli olacak).
   • DateTime.Now markup içindeydi, her render'da değişiyordu → alan.
   • CancellationTokenSource eklendi: hızlı filtre değişiminde uçuşan
     sorgular iptal edilebilir (DB aşaması için hazır).

   NOT: TODO(db) ile işaretli yerler türetilmiş/uydurma değerlerdir.
   Gerçek veriye geçerken yalnızca LoadAsync() ve bu işaretler değişir.
   ================================================================================== *@

@{
    // ==============================================================================
    // SAYFA ŞABLONLARI — YEREL FONKSİYON (local function).
    // Yerel fonksiyon oldukları için bildirim sırası önemsizdir; ayrıca bu blok
    // markup'tan önce geldiği için CS0841 kesin olarak ortadan kalkar.
    // ==============================================================================

    // ---- TreeMap sarmalayıcı -------------------------------------------------------
    // SEÇENEK 1: DevExtreme dxTreeMap (JS interop) — aktif.
    // Blazor-ApexCharts'a dönmek isterseniz tek satır: <DevExtremeTreeMap> → <ApexTreeMap>
    // (parametreler birebir aynı: Data, Selected, OnCellClick)
    RenderFragment TreemapVisual(List<CategoryValue> data, string? selected, Func<string, Task> onCellClick) => @<text>
        <div class="rp-treemap">
            <DevExtremeTreeMap Data="data" Selected="selected" OnCellClick="@(label => onCellClick(label))" />
        </div>
    </text>;

    // ---- ANASAYFA -----------------------------------------------------------------
    RenderFragment RenderAnasayfa() => @<text>
        <section class="rp-card rp-span-12">
            <div class="rp-card-head"><h3>Raporlar</h3><span>@(Tabs.Length - 1) sayfa</span></div>
            <div class="rp-tiles">
                @foreach (var (p, label) in Tabs.Skip(1))
                {
                    <button @key="p" class="rp-tile" @onclick="() => SetPageAsync(p)">
                        <span class="rp-tile-kicker">@(p == DashboardPage.Subeler ? "Kredi · OpRisk" : "BSD · GMD")</span>
                        <span class="rp-tile-title">@label</span>
                    </button>
                }
            </div>
        </section>
    </text>;

    // ---- GENEL BAKIŞ --------------------------------------------------------------
    RenderFragment RenderGenelBakis() => @<text>
        <section class="rp-card rp-span-3">
            <div class="rp-card-head"><h3>Portföy Dağılımı</h3><span>@(portfoy == TumuText ? "Rapor" : portfoy)</span></div>
            @TreemapVisual(Repo.Portfoy, portfoy == TumuText ? null : portfoy, SetPortfoyAsync)
        </section>

        <section class="rp-card rp-span-4">
            <div class="rp-card-head"><h3>Rapor Genel Görüşü</h3><span>Rapor sayısı</span></div>
            @* Pastada tıklanan DİLİMİ bilmek gerekiyor (seri adı yetmez) → args.Point *@
            <DxPieChart Data="Repo.RaporGenelGorusu" CssClass="rp-viz"
                        SeriesClick="@(args => OnGorusClickAsync(args.Point?.Argument?.ToString()))">
                <DxPieChartSeries ValueField="@((CategoryValue c) => c.Value)"
                                  ArgumentField="@(c => c.Label)"
                                  SummaryMethod="Enumerable.Sum">
                    @* DÜZELTME: Percent bir metot → Percent(1)
                       DÜZELTME: DxChartSeriesLabel'da "Format" YOK → doğrusu "ValueFormat".
                       (IntelliSense listenizde ArgumentFormat / ValueFormat / FormatPattern
                        vardı, Format yoktu — ekran görüntünüzde Format'ın altı dalgalıydı.) *@
                    <DxChartSeriesLabel Visible="true"
                                        Position="RelativePosition.Outside"
                                        ValueFormat="@(ChartElementFormat.Percent(1))"
                                        BackgroundColor="TransparentColor" />
                </DxPieChartSeries>
                <DxChartLegend Position="RelativePosition.Outside"
                               HorizontalAlignment="HorizontalAlignment.Center"
                               VerticalAlignment="VerticalEdge.Bottom" />
                @* Çapraz filtre solması: palet LoadAsync içinde crossGorus'a göre hesaplanır.
                   Tıklama bağlantısı için aşağıdaki "PASTA GRAFİK TIKLAMASI" notuna bakın. *@
                <DxChartPalette PaletteName="ChartPalette.Custom" Colors="raporGorusPalette" />
            </DxPieChart>
        </section>

        <section class="rp-card rp-span-5">
            <div class="rp-card-head"><h3>Denetim Plan Yılı ve Bulgu Seviyesi</h3><span>Bulgu sayısı</span></div>
            @* ÇAPRAZ FİLTRE (soru 2): Bir seriye tıklamak o risk seviyesini izole eder,
               tekrar tıklamak bırakır. Seriler artık @if ile GİZLENMİYOR — Power BI'da
               olduğu gibi hepsi duruyor, seçili olmayanlar SOLUYOR (RiskColor).

               args üzerinde Point ve Series üyeleri IntelliSense ile doğrulandı.
               Stacked bar'da seri adı (Düşük/Orta/Yüksek) yeterli olduğu için
               args.Series.Name kullanıyoruz; pastalarda dilim gerektiği için
               args.Point.Argument kullanılıyor. *@
            <DxChart Data="planRows" CssClass="rp-viz" Rotated="true"
                     SeriesClick="@(args => OnRiskSeriesClickAsync(args.Series?.Name))">
                <DxChartStackedBarSeries Name="Düşük" Color="@RiskColor(RiskLevel.Dusuk)"
                                         ArgumentField="@((StackedRow r) => r.Label)" ValueField="@(r => r.Dusuk)">
                    @* Soru 1: renkli kutucuk = etiketin arka plan dolgusu → şeffaf *@
                    <DxChartSeriesLabel Visible="true" BackgroundColor="TransparentColor"
                                        TextOverflow="ChartTextOverflow.Hide" />
                </DxChartStackedBarSeries>

                <DxChartStackedBarSeries Name="Orta" Color="@RiskColor(RiskLevel.Orta)"
                                         ArgumentField="@((StackedRow r) => r.Label)" ValueField="@(r => r.Orta)">
                    <DxChartSeriesLabel Visible="true" BackgroundColor="TransparentColor"
                                        TextOverflow="ChartTextOverflow.Hide" />
                </DxChartStackedBarSeries>

                <DxChartStackedBarSeries Name="Yüksek" Color="@RiskColor(RiskLevel.Yuksek)"
                                         ArgumentField="@((StackedRow r) => r.Label)" ValueField="@(r => r.Yuksek)">
                    <DxChartSeriesLabel Visible="true" BackgroundColor="TransparentColor"
                                        TextOverflow="ChartTextOverflow.Hide" />
                </DxChartStackedBarSeries>

                <DxChartLegend Position="RelativePosition.Outside" VerticalAlignment="VerticalEdge.Bottom"
                               HorizontalAlignment="HorizontalAlignment.Left" />
            </DxChart>
        </section>

        <section class="rp-card rp-span-12">
            <div class="rp-card-head"><h3>Sektörler</h3><span>Paydaş olunan kayıtlar</span></div>
            <DxGrid Data="Repo.Sektorler" ShowGroupPanel="false" CssClass="rp-grid"
                    ShowAllRows="false" PageSize="10" ShowFooter="true">
                <Columns>
                    <DxGridDataColumn FieldName="Sektor" Caption="Sektörler" />
                    <DxGridDataColumn FieldName="Rapor" Caption="Paydaş Olunan Rapor" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="Bulgu" Caption="Paydaş Olunan Bulgu" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="Aksiyon" Caption="Paydaş Olunan Aksiyon" TextAlignment="GridTextAlignment.Right" />
                </Columns>
                <TotalSummary>
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Rapor" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Bulgu" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Aksiyon" />
                </TotalSummary>
            </DxGrid>
        </section>
    </text>;

    // ---- BULGULAR VE AKSİYONLAR ---------------------------------------------------
    RenderFragment RenderBulgular() => @<text>
        <section class="rp-card rp-span-6">
            <div class="rp-card-head"><h3>Sürece Göre Bulgu Dağılımı</h3><span>Bulgu sayısı</span></div>
            <DxChart Data="Repo.BulguSurec" CssClass="rp-viz" Rotated="true">
                <DxChartBarSeries ArgumentField="@((CategoryValue c) => c.Label)" ValueField="@(c => c.Value)"
                                  Color="BlueColor">
                    <DxChartSeriesLabel Visible="true" BackgroundColor="TransparentColor"
                                        TextOverflow="ChartTextOverflow.Hide" />
                </DxChartBarSeries>
                <DxChartLegend Visible="false" />
            </DxChart>
        </section>

        <section class="rp-card rp-span-6">
            <div class="rp-card-head"><h3>Aksiyon Durumu</h3><span>Aksiyon sayısı</span></div>
            <DxPieChart Data="AksiyonDurumu" CssClass="rp-viz" Type="PieChartType.Donut"
                        SeriesClick="@(args => OnAksiyonClickAsync(args.Point?.Argument?.ToString()))">
                <DxPieChartSeries ValueField="@((CategoryValue c) => c.Value)" ArgumentField="@(c => c.Label)"
                                  SummaryMethod="Enumerable.Sum" />
                <DxChartLegend Position="RelativePosition.Outside" VerticalAlignment="VerticalEdge.Bottom" />
                <DxChartPalette PaletteName="ChartPalette.Custom" Colors="aksiyonDurumPalette" />
            </DxPieChart>
        </section>
    </text>;

    // ---- PROJEKSİYON (Aksiyon / Bulgu) --------------------------------------------
    RenderFragment RenderProjeksiyon(List<ProjectionPoint> data, string tur) => @<text>
        <section class="rp-card rp-span-8">
            <div class="rp-card-head"><h3>Kümülatif Kapanış Eğrisi</h3><span>Temmuz — Aralık 2026</span></div>
            <DxChart Data="data" CssClass="rp-viz">
                @* DÜZELTME 3: DashStyle kaldırıldı (CS0103). Doğru tip adını bulunca
                   aşağıdaki Plan serisine geri ekleyin, örn:
                   DashStyle="System.Drawing.Drawing2D.DashStyle.Dash" *@
                <DxChartLineSeries Name="Plan" ArgumentField="@((ProjectionPoint p) => p.Ay)" ValueField="@(p => p.Plan)"
                                   Color="GrayLineColor" />
                <DxChartLineSeries Name="Gerçekleşen" ArgumentField="@((ProjectionPoint p) => p.Ay)" ValueField="@(p => p.Gercek)"
                                   Color="BlueColor" />
                <DxChartLegend Position="RelativePosition.Outside" VerticalAlignment="VerticalEdge.Bottom"
                               HorizontalAlignment="HorizontalAlignment.Left" />
            </DxChart>
        </section>

        <section class="rp-card rp-span-4">
            <div class="rp-card-head"><h3>Termin Takibi</h3><span>@tur</span></div>
            <DxGrid Data="data" CssClass="rp-grid">
                <Columns>
                    <DxGridDataColumn FieldName="Ay" Caption="Ay" />
                    <DxGridDataColumn FieldName="Plan" Caption="Plan (kümülatif)" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn FieldName="Gercek" Caption="Gerçekleşen" TextAlignment="GridTextAlignment.Right" />
                </Columns>
            </DxGrid>
        </section>
    </text>;

    // ---- ŞUBELER ------------------------------------------------------------------
    RenderFragment RenderSubeler() => @<text>
        <section class="rp-card rp-span-5">
            <div class="rp-card-head">
                <h3>Denetim Türü Dağılımı</h3>
                <span>@(denetimTuru ?? TumuText)</span>
            </div>
            @TreemapVisual(Repo.DenetimTuru, denetimTuru, ToggleDenetimTuruAsync)
        </section>

        <section class="rp-card rp-span-4">
            <div class="rp-card-head"><h3>Rapor Görüş Seviyeleri</h3><span>Rapor sayısı</span></div>
            <DxPieChart Data="Repo.RaporGorusSeviyeleri" CssClass="rp-viz" Type="PieChartType.Donut"
                        SeriesClick="@(args => OnGorusSeviyeClickAsync(args.Point?.Argument?.ToString()))">
                <DxPieChartSeries ValueField="@((CategoryValue c) => c.Value)" ArgumentField="@(c => c.Label)"
                                  SummaryMethod="Enumerable.Sum">
                    <DxChartSeriesLabel Visible="true" Position="RelativePosition.Outside"
                                        BackgroundColor="TransparentColor" />
                </DxPieChartSeries>
                <DxChartLegend Position="RelativePosition.Outside" VerticalAlignment="VerticalEdge.Bottom" />
                <DxChartPalette PaletteName="ChartPalette.Custom" Colors="gorusSeviyePalette" />
            </DxPieChart>
        </section>

        <section class="rp-card rp-span-3">
            <div class="rp-card-head"><h3>Bulgu Seviyeleri</h3><span>Bulgu sayısı</span></div>
            @* Eskiden TEK seri + 3 nokta vardı; tek seride her noktaya farklı renk vermek
               CustomizeSeriesPoint gerektiriyor. Onun yerine 3 AYRI SERİ kullanıyoruz:
               her serinin kendi Color'ı var → solma ve tıklama bedava geliyor,
               doğrulaması belirsiz hiçbir API'ye ihtiyaç kalmıyor. *@
            <DxChart Data="bulguSeviyeBars" CssClass="rp-viz" Rotated="true"
                     SeriesClick="@(args => OnRiskSeriesClickAsync(args.Series?.Name))">
                <DxChartBarSeries Name="Yüksek" Color="@RiskColor(RiskLevel.Yuksek)"
                                  ArgumentField="@((RiskBar b) => b.Label)" ValueField="@(b => b.Yuksek)">
                    <DxChartSeriesLabel Visible="true" BackgroundColor="TransparentColor"
                                        TextOverflow="ChartTextOverflow.Hide" />
                </DxChartBarSeries>
                <DxChartBarSeries Name="Orta" Color="@RiskColor(RiskLevel.Orta)"
                                  ArgumentField="@((RiskBar b) => b.Label)" ValueField="@(b => b.Orta)">
                    <DxChartSeriesLabel Visible="true" BackgroundColor="TransparentColor"
                                        TextOverflow="ChartTextOverflow.Hide" />
                </DxChartBarSeries>
                <DxChartBarSeries Name="Düşük" Color="@RiskColor(RiskLevel.Dusuk)"
                                  ArgumentField="@((RiskBar b) => b.Label)" ValueField="@(b => b.Dusuk)">
                    <DxChartSeriesLabel Visible="true" BackgroundColor="TransparentColor"
                                        TextOverflow="ChartTextOverflow.Hide" />
                </DxChartBarSeries>
                <DxChartLegend Visible="false" />
            </DxChart>
        </section>

        <section class="rp-card rp-span-12">
            <div class="rp-card-head"><h3>Denetlenen Şubeler</h3><span>@subeler.Count kayıt</span></div>
            @* subeler materialize edilmiş List'tir: grid veri kaynağını her render'da yeniden okumaz *@
            <DxGrid Data="subeler" CssClass="rp-grid" VirtualScrollingEnabled="true" ShowFilterRow="false">
                <Columns>
                    <DxGridDataColumn FieldName="DenetimTuru" Caption="Denetim Türü" />
                    <DxGridDataColumn FieldName="SubeAdi" Caption="Şube Adı" />
                    <DxGridDataColumn FieldName="Risk" Caption="Risk Seviyesi" TextAlignment="GridTextAlignment.Right" />
                </Columns>
            </DxGrid>
            <p class="rp-note">*İklim ve İç Ortam denetimlerinde bulgu bulunmadığı için risk seviyesi filtresi bu satırları gizleyebilir.</p>
        </section>
    </text>;
}

<div class="rp-app">

    @* ÜST BAŞLIK *@
    <header class="rp-header">
        <div class="rp-brand">
            <div class="rp-logo">D3</div>
            <div class="rp-brand-text">
                <span>Denetim · Danışmanlık</span>
                <span class="muted">Dönüşüm</span>
            </div>
        </div>
        <div class="rp-header-main">
            <div>
                <div class="rp-kicker">@PageKicker</div>
                <h1 class="rp-title">@PageTitle</h1>
            </div>
            <div class="rp-header-actions">
                <span class="rp-refresh">Son yenileme @lastRefresh.ToString("dd.MM.yyyy HH:mm")</span>
                <DxButton RenderStyle="ButtonRenderStyle.None" CssClass="rp-btn-outline"
                          Text="Filtreleri sıfırla" Click="ResetFiltersAsync" />
                <DxButton RenderStyle="ButtonRenderStyle.None" CssClass="rp-btn-accent"
                          Text="@(filtersOpen ? "Filtreleri gizle" : "Filtreler")"
                          Click="@(() => filtersOpen = !filtersOpen)" />
            </div>
        </div>
    </header>

    <div class="rp-body">

        @* SOL RAY — KPI kartları + dilimleyiciler *@
        <aside class="rp-rail">
            @foreach (var kpi in kpis)
            {
                <div class="rp-kpi" @key="kpi.Label">
                    <div class="rp-kpi-label">@kpi.Label</div>
                    <div class="rp-kpi-value">
                        @kpi.Value
                        @if (!string.IsNullOrEmpty(kpi.Delta))
                        {
                            <span class="rp-kpi-delta">@kpi.Delta</span>
                        }
                    </div>
                </div>
            }

            <div class="rp-rail-divider"></div>

            @if (ShowPlanSlicer)
            {
                <div class="rp-slicer">
                    <div class="rp-slicer-label">Plan Yılı</div>
                    <div class="rp-slicer-group">
                        @foreach (var y in PlanYearOptions)
                        {
                            <button @key="y" class="@SlicerCss(planYears.Contains(y))"
                                    @onclick="() => TogglePlanYearAsync(y)">@y</button>
                        }
                    </div>
                </div>
            }

            @if (ShowPortfoySlicer)
            {
                <div class="rp-slicer">
                    <div class="rp-slicer-label">Portföy</div>
                    <div class="rp-slicer-group">
                        @foreach (var p in PortfoyOptions)
                        {
                            <button @key="p" class="@SlicerCss(portfoy == p)"
                                    @onclick="() => SetPortfoyAsync(p)">@p</button>
                        }
                    </div>
                </div>
            }

            @if (ShowRiskSlicer)
            {
                <div class="rp-slicer">
                    <div class="rp-slicer-label">Risk Seviyesi</div>
                    <div class="rp-slicer-group">
                        @foreach (var r in AllRiskLevels)
                        {
                            <button @key="r" class="@SlicerCss(riskLevels.Contains(r))"
                                    @onclick="() => ToggleRiskAsync(r)">@RiskName(r)</button>
                        }
                    </div>
                </div>
            }

            @* Çapraz filtre aktifken kullanıcı neyi filtrelediğini görmeli.
               Power BI'da bu görsel üzerindeki vurgudan anlaşılır; burada
               açıkça yazıp tek tıkla kaldırma imkânı veriyoruz. *@
            @{
                var aktifCapraz = ActiveCrossFilters().ToList();
            }
            @if (aktifCapraz.Count > 0)
            {
                <div class="rp-slicer">
                    <div class="rp-slicer-label">Grafik Seçimi</div>
                    <div class="rp-slicer-group">
                        @foreach (var cf in aktifCapraz)
                        {
                            <button @key="cf.Label" class="rp-chip rp-chip-on" @onclick="cf.Clear">
                                @cf.Label ✕
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="rp-rail-note">@RailFootnote</div>
        </aside>

        @* TUVAL — sayfaya göre görseller *@
        <main class="rp-canvas">
            @switch (page)
            {
                case DashboardPage.Anasayfa:
                    @RenderAnasayfa()
                    break;
                case DashboardPage.GenelBakis:
                    @RenderGenelBakis()
                    break;
                case DashboardPage.BulgularAksiyonlar:
                    @RenderBulgular()
                    break;
                case DashboardPage.AksiyonProjeksiyon:
                    @RenderProjeksiyon(Repo.AksiyonProjeksiyon, "Aksiyon")
                    break;
                case DashboardPage.BulguProjeksiyon:
                    @RenderProjeksiyon(Repo.BulguProjeksiyon, "Bulgu")
                    break;
                case DashboardPage.Subeler:
                    @RenderSubeler()
                    break;
            }
        </main>

        @* SAĞ FİLTRE PANELİ *@
        @if (filtersOpen)
        {
            <aside class="rp-filters">
                <div class="rp-filters-head">
                    <h3>Filtreler</h3>
                    <DxButton RenderStyle="ButtonRenderStyle.None" CssClass="rp-btn-link"
                              Text="Kapat" Click="@(() => filtersOpen = false)" />
                </div>

                @* Her tuş vuruşunda değil, 350 ms sessizlikten sonra filtrele.
                   (InputDelay parametresi sürümünüzde yoksa sadece o niteliği silin;
                    BindValueMode.OnDelayedInput varsayılan gecikmeyle çalışır.) *@
                <DxTextBox @bind-Text="Search" NullText="Ara" CssClass="rp-search"
                           BindValueMode="BindValueMode.OnDelayedInput" InputDelay="350" />

                <div class="rp-filter-group">
                    <div class="rp-filter-label">Risk Seviyesi</div>
                    @foreach (var r in AllRiskLevels)
                    {
                        <button @key="r" class="@FilterCss(riskLevels.Contains(r))"
                                @onclick="() => ToggleRiskAsync(r)">
                            <span>@RiskName(r)</span>
                            <span class="rp-count">@RiskCount(r)</span>
                        </button>
                    }
                </div>

                <div class="rp-filter-group">
                    <div class="rp-filter-label">Denetim Türü</div>
                    @foreach (var t in Repo.DenetimTuru)
                    {
                        <button @key="t.Label" class="@FilterCss(denetimTuru == t.Label)"
                                @onclick="() => ToggleDenetimTuruAsync(t.Label)">
                            <span>@t.Label</span>
                            <span class="rp-count">@t.Value.ToString("N0")</span>
                        </button>
                    }
                </div>

                <div class="rp-filter-group">
                    <div class="rp-filter-label">Plan Yılı</div>
                    @foreach (var row in Repo.PlanYiliBulgu)
                    {
                        <button @key="row.Label" class="@FilterCss(planYears.Contains(row.Label))"
                                @onclick="() => TogglePlanYearAsync(row.Label)">
                            <span>@row.Label</span>
                            <span class="rp-count">@row.Total</span>
                        </button>
                    }
                </div>
            </aside>
        }
    </div>

    @* ALT SAYFA SEKMELERİ — Power BI page tabs *@
    <nav class="rp-tabs">
        @foreach (var (p, label) in Tabs)
        {
            <button @key="p" class="@(page == p ? "rp-tab rp-tab-active" : "rp-tab")"
                    @onclick="() => SetPageAsync(p)">@label</button>
        }
    </nav>
</div>

@code {
    // ==============================================================================
    // SABİTLER — her render'da yeniden ayrılmasınlar diye static readonly
    // ==============================================================================
    const string TumuText = "Tümü";

    static readonly string[] PlanYearOptions = { "2025", "2026" };
    static readonly string[] PortfoyOptions = { TumuText, "BSD", "GMD", "KBD" };
    static readonly RiskLevel[] AllRiskLevels = Enum.GetValues<RiskLevel>();

    static readonly (DashboardPage Page, string Label)[] Tabs =
    {
        (DashboardPage.Anasayfa,            "Anasayfa"),
        (DashboardPage.GenelBakis,          "2026 2Ç Genel Bakış (BSD-GMD)"),
        (DashboardPage.BulgularAksiyonlar,  "2026 2Ç Bulgular ve Aksiyonlar"),
        (DashboardPage.AksiyonProjeksiyon,  "2026 2Ç Aksiyon Kapama Projeksiyonu"),
        (DashboardPage.BulguProjeksiyon,    "2026 2Ç Bulgu Kapanma Projeksiyonu"),
        (DashboardPage.Subeler,             "2026 2Ç Şubeler (Kredi-OpRisk)")
    };

    // System.Drawing.Color.FromArgb(...) her render'da çağrılmasın
    static readonly System.Drawing.Color TealColor      = System.Drawing.Color.FromArgb(0x12, 0xa3, 0xa0);
    static readonly System.Drawing.Color OrangeColor    = System.Drawing.Color.FromArgb(0xe8, 0x85, 0x3c);
    static readonly System.Drawing.Color RedColor       = System.Drawing.Color.FromArgb(0xc0, 0x00, 0x00);
    static readonly System.Drawing.Color BlueColor      = System.Drawing.Color.FromArgb(0x22, 0x22, 0xc8);
    static readonly System.Drawing.Color GrayLineColor  = System.Drawing.Color.FromArgb(0x8c, 0x8c, 0x8c);

    // Soru 1: etiketlerin arkasındaki renkli kutucuğu kaldırmak için
    static readonly System.Drawing.Color TransparentColor = System.Drawing.Color.Transparent;

    // Soru 2: çapraz filtrede seçili OLMAYAN öğelerin rengi (Power BI'daki solma)
    const string DimHex = "#c9c9c9";
    static readonly System.Drawing.Color DimDrawColor = System.Drawing.Color.FromArgb(0xc9, 0xc9, 0xc9);

    // NOT: Eski RaporGorusRenkleri / GorusSeviyeRenkleri / AksiyonDurumRenkleri sabit
    // listeleri kaldırıldı. Paletler artık LoadAsync içinde DimPalette() ile
    // CategoryValue.Color alanından üretiliyor — böylece çapraz filtre solması
    // otomatik olarak paletin içine giriyor ve renkler tek yerde tanımlı kalıyor.

    // TODO(db): gerçek aksiyon durumu dağılımını LoadAsync içinde doldurun
    static readonly List<CategoryValue> AksiyonDurumu = new()
    {
        new("Kapandı",      96, ReportColors.Teal),
        new("Devam ediyor", 65, ReportColors.Orange),
        new("Gecikmiş",     44, ReportColors.Red)
    };

    // ==============================================================================
    // FİLTRE DURUMU
    // ==============================================================================
    DashboardPage page = DashboardPage.GenelBakis;
    HashSet<string> planYears = new(PlanYearOptions);
    HashSet<RiskLevel> riskLevels = new(AllRiskLevels);
    string portfoy = TumuText;
    string? denetimTuru;
    bool filtersOpen = true;
    DateTime lastRefresh;

    string _search = string.Empty;
    string Search
    {
        get => _search;
        set
        {
            if (_search == value) return;
            _search = value ?? string.Empty;
            _ = LoadAsync();          // OnDelayedInput sayesinde tuş başına değil
        }
    }

    // ==============================================================================
    // HESAPLANMIŞ (ÖNBELLEKLENMİŞ) VERİ
    // Eskiden bunlar computed property'ydi ve her render'da YENİ referans üretip
    // DxGrid/DxChart'ı sıfırdan yükletiyordu. Artık sadece LoadAsync() doldurur.
    // ==============================================================================
    List<StackedRow> planRows = new();
    List<SubeRow> subeler = new();
    List<KpiItem> kpis = new();
    int bulguToplam;
    int subeBulguToplam;

    // ==============================================================================
    // SORU 2 — ÇAPRAZ FİLTRE (Power BI davranışı)
    //
    // Dilimleyiciler (sol raydaki Plan Yılı / Risk / Portföy) VERİYİ filtreler.
    // Çapraz filtre ise bir GÖRSELE tıklamakla oluşur: tıklanan değer diğer
    // görselleri filtreler ve tıklanan görselde diğer renkler solar.
    // Bu ikisini ayrı tutmak önemli — aynı state'i paylaşsalar tıklama
    // dilimleyiciyi sessizce değiştirir ve kullanıcı neyi filtrelediğini şaşırır.
    // ==============================================================================
    RiskLevel? crossRisk;          // Bulgu seviyesi / plan yılı grafiklerinden
    string? crossGorus;            // Rapor Genel Görüşü pastası
    string? crossGorusSeviye;      // Rapor Görüş Seviyeleri pastası
    string? crossAksiyon;          // Aksiyon Durumu pastası

    /// <summary>Bir seri seçiliyse seçili olmayanlar soluk gri döner.</summary>
    System.Drawing.Color RiskColor(RiskLevel r)
        => crossRisk is null || crossRisk == r ? BaseRiskColor(r) : DimDrawColor;

    static System.Drawing.Color BaseRiskColor(RiskLevel r) => r switch
    {
        RiskLevel.Yuksek => RedColor,
        RiskLevel.Orta => OrangeColor,
        _ => TealColor
    };

    /// <summary>Pasta/treemap paletlerinde seçili olmayanları soluklaştırır.</summary>
    static List<string> DimPalette(IEnumerable<CategoryValue> items, string? selected)
        => items.Select(i => selected is null || i.Label == selected ? i.Color : DimHex).ToList();

    // Paletler LoadAsync içinde hesaplanır (her render'da yeni List üretmemek için —
    // yeni referans DevExpress grafiğini sıfırdan yükletiyor)
    List<string> raporGorusPalette = new();
    List<string> gorusSeviyePalette = new();
    List<string> aksiyonDurumPalette = new();

    /// <summary>Bulgu Seviyeleri grafiği için 3 ayrı seri modeli.</summary>
    public record RiskBar(string Label, double? Yuksek, double? Orta, double? Dusuk);
    List<RiskBar> bulguSeviyeBars = new();

    /// <summary>Grafik serisine tıklanınca: aynı seriye tekrar tıklamak filtreyi kaldırır.</summary>
    async Task OnRiskSeriesClickAsync(string? seriesName)
    {
        var clicked = seriesName switch
        {
            "Yüksek" => RiskLevel.Yuksek,
            "Orta" => RiskLevel.Orta,
            "Düşük" => RiskLevel.Dusuk,
            _ => (RiskLevel?)null
        };
        if (clicked is null) return;

        crossRisk = crossRisk == clicked ? null : clicked;
        await LoadAsync();
    }

    // ---- Pasta grafik tıklamaları -------------------------------------------------
    // args.Point.Argument tıklanan dilimin etiketini verir. Aynı dilime tekrar
    // tıklamak filtreyi kaldırır (Power BI davranışı).
    async Task OnGorusClickAsync(string? label)
    {
        crossGorus = (label is null || crossGorus == label) ? null : label;
        await LoadAsync();
    }

    async Task OnGorusSeviyeClickAsync(string? label)
    {
        crossGorusSeviye = (label is null || crossGorusSeviye == label) ? null : label;
        await LoadAsync();
    }

    async Task OnAksiyonClickAsync(string? label)
    {
        crossAksiyon = (label is null || crossAksiyon == label) ? null : label;
        await LoadAsync();
    }

    /// <summary>Sol raydaki "Grafik Seçimi" çipleri için: (etiket, temizleme işlemi).</summary>
    IEnumerable<(string Label, Func<Task> Clear)> ActiveCrossFilters()
    {
        if (crossRisk is not null)
            yield return (RiskName(crossRisk.Value), () => OnRiskSeriesClickAsync(RiskName(crossRisk!.Value)));
        if (crossGorus is not null)
            yield return (crossGorus, () => OnGorusClickAsync(crossGorus));
        if (crossGorusSeviye is not null)
            yield return (crossGorusSeviye, () => OnGorusSeviyeClickAsync(crossGorusSeviye));
        if (crossAksiyon is not null)
            yield return (crossAksiyon, () => OnAksiyonClickAsync(crossAksiyon));
    }

    void ClearCrossFilters()
    {
        crossRisk = null;
        crossGorus = null;
        crossGorusSeviye = null;
        crossAksiyon = null;
    }

    async Task ClearCrossFiltersAsync()
    {
        ClearCrossFilters();
        await LoadAsync();
    }

    CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync()
    {
        lastRefresh = DateTime.Now;
        await LoadAsync();
    }

    // ==============================================================================
    // TEK VERİ GİRİŞ NOKTASI
    // Veritabanına geçerken DEĞİŞECEK TEK METOT BURASI. İçindeki Repo.* çağrılarını
    // await DashboardService.GetAsync(filter, ct) ile değiştirin; markup'a dokunmayın.
    // ==============================================================================
    async Task LoadAsync()
    {
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        var ct = cts.Token;

        // ---- şu an bellek içi; DB'de burada tek bir await olacak -------------------
        planRows = Repo.PlanYiliBulgu
            .Where(r => planYears.Contains(r.Label))
            .ToList();

        bulguToplam = planRows.Sum(r =>
            (riskLevels.Contains(RiskLevel.Dusuk) ? r.Dusuk : 0) +
            (riskLevels.Contains(RiskLevel.Orta) ? r.Orta : 0) +
            (riskLevels.Contains(RiskLevel.Yuksek) ? r.Yuksek : 0));

        var riskNames = riskLevels.Select(RiskName).ToHashSet(StringComparer.OrdinalIgnoreCase);
        subeBulguToplam = Repo.SubeBulguSeviyeleri
            .Where(c => riskNames.Contains(c.Label))
            .Sum(c => (int)c.Value);

        subeler = Repo.Subeler
            .Where(s => denetimTuru is null || s.DenetimTuru == denetimTuru)
            .Where(s => riskLevels.Contains(s.Risk))
            .Where(s => crossRisk is null || s.Risk == crossRisk)      // çapraz filtre
            .Where(s => string.IsNullOrWhiteSpace(_search)
                        || s.SubeAdi.Contains(_search, StringComparison.CurrentCultureIgnoreCase)
                        || s.DenetimTuru.Contains(_search, StringComparison.CurrentCultureIgnoreCase))
            .ToList();

        // ---- Bulgu Seviyeleri: tek listeden 3 seriye ---------------------------
        // Her satırda yalnız bir sütun dolu; böylece her risk seviyesi kendi
        // rengine ve kendi tıklama olayına sahip bir seri olur.
        bulguSeviyeBars = Repo.SubeBulguSeviyeleri.Select(c => new RiskBar(
            c.Label,
            c.Label == "Yüksek" ? c.Value : null,
            c.Label == "Orta" ? c.Value : null,
            c.Label == "Düşük" ? c.Value : null)).ToList();

        // ---- Çapraz filtre paletleri ------------------------------------------
        raporGorusPalette   = DimPalette(Repo.RaporGenelGorusu, crossGorus);
        gorusSeviyePalette  = DimPalette(Repo.RaporGorusSeviyeleri, crossGorusSeviye);
        aksiyonDurumPalette = DimPalette(AksiyonDurumu, crossAksiyon);

        kpis = BuildKpis();

        if (ct.IsCancellationRequested) return;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }

    // ==============================================================================
    // FİLTRE / SAYFA OLAYLARI — hepsi LoadAsync() üzerinden geçer
    // ==============================================================================
    async Task SetPageAsync(DashboardPage p)
    {
        if (page == p) return;
        page = p;
        await LoadAsync();
    }

    async Task TogglePlanYearAsync(string y)
    {
        if (!planYears.Add(y))
        {
            if (planYears.Count <= 1) return;   // en az bir yıl seçili kalsın
            planYears.Remove(y);
        }
        await LoadAsync();
    }

    async Task ToggleRiskAsync(RiskLevel r)
    {
        if (!riskLevels.Add(r))
        {
            if (riskLevels.Count <= 1) return;
            riskLevels.Remove(r);
        }
        await LoadAsync();
    }

    async Task SetPortfoyAsync(string p)
    {
        // treemap'ten aynı hücreye tekrar tıklanırsa filtreyi kaldır
        portfoy = (portfoy == p && p != TumuText) ? TumuText : p;
        await LoadAsync();
    }

    async Task ToggleDenetimTuruAsync(string t)
    {
        denetimTuru = denetimTuru == t ? null : t;
        await LoadAsync();
    }

    async Task ResetFiltersAsync()
    {
        planYears = new(PlanYearOptions);
        riskLevels = new(AllRiskLevels);
        portfoy = TumuText;
        denetimTuru = null;
        _search = string.Empty;
        ClearCrossFilters();
        lastRefresh = DateTime.Now;
        await LoadAsync();
    }

    // ==============================================================================
    // GÖRÜNÜM YARDIMCILARI
    // ==============================================================================
    static string RiskName(RiskLevel r) => r switch
    {
        RiskLevel.Yuksek => "Yüksek",
        RiskLevel.Orta => "Orta",
        _ => "Düşük"
    };

    int RiskCount(RiskLevel r) => Repo.PlanYiliBulgu.Sum(x => r switch
    {
        RiskLevel.Yuksek => x.Yuksek,
        RiskLevel.Orta => x.Orta,
        _ => x.Dusuk
    });

    static string SlicerCss(bool active) => active ? "rp-chip rp-chip-on" : "rp-chip";
    static string FilterCss(bool active) => active ? "rp-filter-item rp-filter-on" : "rp-filter-item";

    bool ShowPlanSlicer => page != DashboardPage.Subeler;
    bool ShowPortfoySlicer => page is DashboardPage.GenelBakis
                                   or DashboardPage.AksiyonProjeksiyon
                                   or DashboardPage.BulguProjeksiyon;
    bool ShowRiskSlicer => page is DashboardPage.Subeler or DashboardPage.BulgularAksiyonlar;

    string PageKicker => page switch
    {
        DashboardPage.Subeler => "Kredi · OpRisk · İklim İç Ortam — 2026 2. Çeyrek",
        DashboardPage.Anasayfa => "Denetim Danışmanlık Dönüşüm — Raporlama Portalı",
        _ => "BSD · GMD · İştirakler — 2026 2. Çeyrek"
    };

    string PageTitle => page switch
    {
        DashboardPage.Anasayfa => "Anasayfa",
        DashboardPage.GenelBakis => "Bilgi Sistemleri, Genel Müdürlük ve İştirakler",
        DashboardPage.BulgularAksiyonlar => "Bulgular ve Aksiyonlar",
        DashboardPage.AksiyonProjeksiyon => "Aksiyon Kapama Projeksiyonu",
        DashboardPage.BulguProjeksiyon => "Bulgu Kapanma Projeksiyonu",
        _ => "Şubeler — Tamamlanan Denetimler"
    };

    string RailFootnote => page == DashboardPage.Subeler
        ? "*İklim ve İç Ortam denetimlerinde bulgu bulunmaması nedeniyle, ilgili filtreleme sonucunda tabloda veri görüntülenmeyebilir."
        : "Kaynak: Denetim Takip Sistemi · Plan Yılı ve Portföy dilimleyicileri tüm görselleri etkiler.";

    // ==============================================================================
    // KPI'LAR
    // TODO(db): buradaki sabit ("89", "96", "109") ve türetilmiş (*1.34, != 201,
    // != 153) değerlerin tamamı Power BI ölçülerinin yerine geçen SQL agregalarıyla
    // değiştirilecek. Şu an yalnız düzenin doğru görünmesi için duruyorlar.
    // ==============================================================================
    List<KpiItem> BuildKpis() => page switch
    {
        DashboardPage.Subeler => new()
        {
            new("Denetlenen Şube Sayısı", "89"),                                   // TODO(db)
            new("Tamamlanan Rapor Sayısı", "89"),                                  // TODO(db)
            new("Toplam Bulgu Sayısı*", subeBulguToplam.ToString("N0"),
                subeBulguToplam != 201 ? "filtreli" : null)                        // TODO(db)
        },
        DashboardPage.BulgularAksiyonlar => new()
        {
            new("Bulgu Sayısı", bulguToplam.ToString("N0")),
            new("Aksiyon Sayısı", ((int)(bulguToplam * 1.34)).ToString("N0")),      // TODO(db)
            new("Kapanan Aksiyon", "96"),                                          // TODO(db)
            new("Açık Aksiyon", "109")                                             // TODO(db)
        },
        DashboardPage.AksiyonProjeksiyon or DashboardPage.BulguProjeksiyon => ProjeksiyonKpis(),
        DashboardPage.Anasayfa => new()
        {
            new("Tamamlanan Rapor", "110", "2026 2Ç"),                             // TODO(db)
            new("Toplam Bulgu", "354"),                                            // TODO(db)
            new("Açık Aksiyon", "109")                                             // TODO(db)
        },
        _ => new()
        {
            new("Tamamlanan Rapor Sayısı", RaporToplam.ToString("N0")),
            new("Bulgu Sayısı", bulguToplam.ToString("N0"),
                bulguToplam != 153 ? "filtreli" : null),                           // TODO(db)
            new("Aksiyon Sayısı", ((int)(bulguToplam * 1.34)).ToString("N0"))       // TODO(db)
        }
    };

    // TODO(db): SQL'den COUNT(DISTINCT RaporId) gelecek
    int RaporToplam => planYears.Count == 2 ? 21 : (planYears.Contains("2026") ? 18 : 3);

    List<KpiItem> ProjeksiyonKpis()
    {
        var src = page == DashboardPage.AksiyonProjeksiyon ? Repo.AksiyonProjeksiyon : Repo.BulguProjeksiyon;

        if (src.Count == 0)
            return new() { new("Planlanan Kapanış", "—"), new("Gerçekleşen", "—"), new("Sapma", "—") };

        var planSon = src[^1].Plan;

        // Eski kod src.Last(p => p.Gercek.HasValue) kullanıyordu → hiç gerçekleşme
        // yoksa InvalidOperationException. Gerçek veride bu hâl mutlaka olacak.
        var son = src.LastOrDefault(p => p.Gercek.HasValue);
        if (son is null)
            return new()
            {
                new("Planlanan Kapanış", planSon.ToString("N0")),
                new("Gerçekleşen", "—", "veri yok"),
                new("Sapma", "—")
            };

        var gercek = son.Gercek!.Value;
        var oran = son.Plan == 0 ? (double?)null : (double)gercek / son.Plan;   // sıfıra bölme koruması

        return new()
        {
            new("Planlanan Kapanış", planSon.ToString("N0")),
            new("Gerçekleşen", gercek.ToString("N0"), oran.HasValue ? $"{oran:P1} hedef" : null),
            new("Sapma", (gercek - son.Plan).ToString("N0"), gercek < son.Plan ? "gecikme" : "ileride")
        };
    }
}
