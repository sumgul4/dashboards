@* DevExtreme dxTreeMap sarmalayıcısı (Seçenek 1 — JS interop)
   Gereksinim: sayfada dx.all.js + wwwroot/js/treemap-interop.js

   v2 DEĞİŞİKLİKLERİ
   • OnAfterRenderAsync her render'da update() çağırıyordu. Blazor Server'da bu,
     üst bileşenin her render'ında (ör. arama kutusundaki her tuş vuruşunda)
     SignalR üzerinden bir interop çağrısı + tüm veri dizisinin yeniden
     serileştirilmesi anlamına geliyordu. Artık imza karşılaştırması var.
   • İki farklı [JSInvokable] aynı işi yapıyordu (biri ölü kod); tek metoda indi.
   • Payload her çağrıda yeniden üretiliyordu; yalnız değişimde üretiliyor.
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="host" class="dxtm-host" style="width:100%;height:100%;min-height:150px"></div>

@code {
    [Parameter, EditorRequired] public List<CategoryValue> Data { get; set; } = new();

    /// <summary>Seçili hücrenin etiketi (çapraz filtre). null = seçim yok.</summary>
    [Parameter] public string? Selected { get; set; }

    [Parameter] public EventCallback<string> OnCellClick { get; set; }

    ElementReference host;
    IJSObjectReference? module;
    DotNetObjectReference<DevExtremeTreeMap>? selfRef;
    bool created;
    string? renderedSignature;

    record Point(string name, double value, string color);

    object[] BuildPayload() => Data.Select(d => (object)new Point(d.Label, d.Value, d.Color)).ToArray();

    string BuildSignature()
    {
        var sb = new System.Text.StringBuilder();
        foreach (var d in Data)
        {
            sb.Append(d.Label).Append(':').Append(d.Value).Append('|');
        }
        sb.Append('#').Append(Selected);
        return sb.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/treemap-interop.js");
            selfRef = DotNetObjectReference.Create(this);
            renderedSignature = BuildSignature();
            await module.InvokeVoidAsync("create", host, BuildPayload(), selfRef, Selected);
            created = true;
            return;
        }

        if (!created || module is null) return;

        var signature = BuildSignature();
        if (signature == renderedSignature) return;   // gereksiz interop yapmayalım

        renderedSignature = signature;
        await module.InvokeVoidAsync("update", host, BuildPayload(), Selected);
    }

    // JS modülü bu adı çağırır (treemap-interop.js → invokeMethodAsync('OnCellClick', label))
    [JSInvokable("OnCellClick")]
    public Task OnCellClickInterop(string label) => OnCellClick.InvokeAsync(label);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                if (created) await module.InvokeVoidAsync("dispose", host);
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { /* devre kapandı, temizlik gereksiz */ }
        catch (TaskCanceledException) { }
        finally
        {
            selfRef?.Dispose();
        }
    }
}
