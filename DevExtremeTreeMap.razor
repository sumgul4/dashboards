@* DevExtreme dxTreeMap sarmalayıcısı (Seçenek 1 — JS interop)
   Gereksinim: sayfada dx.all.js + wwwroot/js/treemap-interop.js *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="host" class="dxtm-host" style="width:100%;height:100%;min-height:150px"></div>

@code {
    [Parameter, EditorRequired] public List<CategoryValue> Data { get; set; } = new();
    /// <summary>Seçili hücrenin etiketi (çapraz filtre).</summary>
    [Parameter] public string? Selected { get; set; }
    [Parameter] public EventCallback<string> OnCellClick { get; set; }

    ElementReference host;
    IJSObjectReference? module;
    DotNetObjectReference<DevExtremeTreeMap>? selfRef;
    bool created;

    record Point(string name, double value, string color);
    object[] Payload => Data.Select(d => new Point(d.Label, d.Value, d.Color)).Cast<object>().ToArray();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/treemap-interop.js");
            selfRef = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("create", host, Payload, selfRef, Selected);
            created = true;
        }
        else if (created && module is not null)
        {
            await module.InvokeVoidAsync("update", host, Payload, Selected);
        }
    }

    [JSInvokable]
    public Task OnCellClickFromJs(string label) => OnCellClick.InvokeAsync(label);

    // JS modülü 'OnCellClick' adıyla çağırır
    [JSInvokable("OnCellClick")]
    public Task OnCellClickInterop(string label) => OnCellClick.InvokeAsync(label);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null && created) await module.InvokeVoidAsync("dispose", host);
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        selfRef?.Dispose();
    }
}
